# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Get your connection string from https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g. https://yourdomain.com)
# Leave blank to restrict to same-origin only in production
ALLOWED_ORIGINS=http://localhost:3000

# ─── Debug (optional) ─────────────────────────────────────────────────────────
# Set to "true" to log DB query timings
DEBUG_TIMING=false
